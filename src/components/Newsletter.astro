---
interface Props {
  action?: string;
  placeholder?: string;
  buttonText?: string;
}

const {
  action = "https://buttondown.com/api/emails/embed-subscribe/riroo",
  placeholder = "your@email.com",
  buttonText = "Subscribe",
} = Astro.props;
---

<section class="bento nl-section">
  <div class="nl-inner">
    <h3>Stay in touch</h3>
    <p>New posts delivered to your inbox. No spam, ever.</p>
    <form class="nl-form" action={action} method="post" target="_blank">
      <input type="email" name="email" placeholder={placeholder} required />
      <button type="submit">{buttonText}</button>
    </form>
  </div>
</section>

<style>
  .nl-section {
    padding: 1.75em;
  }

  .nl-inner {
    text-align: center;
  }

  .nl-inner h3 {
    font-size: 1.1em;
    margin-bottom: 0.3em;
  }

  .nl-inner p {
    font-size: 0.88em;
    color: rgb(var(--gray));
    margin-bottom: 0.8em;
  }

  .nl-form {
    display: flex;
    gap: 0.5em;
    max-width: 380px;
    margin: 0 auto;
  }

  .nl-form input {
    flex: 1;
    padding: 0.6em 1em;
    border: 1px solid rgb(var(--border));
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    background: rgb(var(--background));
    color: rgb(var(--black));
    outline: none;
    transition: border-color 0.2s;
  }

  .nl-form input:focus {
    border-color: var(--accent);
  }

  .nl-form button {
    padding: 0.6em 1.1em;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .nl-form button:hover {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .nl-form {
      flex-direction: column;
    }
  }
</style>
