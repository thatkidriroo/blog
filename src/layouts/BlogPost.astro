---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Cusdis from '../components/Cusdis.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .post-main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2em 1.5em 3em;
      }

      .post-back {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        font-size: 0.88em;
        color: rgb(var(--gray));
        margin-bottom: 2em;
      }

      .post-back:hover {
        color: var(--accent);
        text-decoration: none;
      }

      .post-hero {
        margin-bottom: 2em;
      }

      .post-hero img {
        display: block;
        border-radius: var(--radius);
        width: 100%;
        box-shadow: var(--box-shadow);
      }

      .post-head {
        margin-bottom: 2.5em;
      }

      .post-head h1 {
        font-size: 2em;
        margin-bottom: 0.3em;
        line-height: 1.3;
      }

      .post-head-meta {
        font-size: 0.88em;
        color: rgb(var(--gray));
        margin-bottom: 0.75em;
      }

      .post-head-meta .updated {
        margin-left: 0.3em;
      }

      .post-tags {
        display: flex;
        gap: 0.4em;
        flex-wrap: wrap;
      }

      .post-tags .tag {
        padding: 0.15em 0.6em;
        background: rgb(var(--gray-light));
        border-radius: 6px;
        font-size: 0.8em;
        color: rgb(var(--gray));
        text-decoration: none;
        transition: all 0.12s;
      }

      .post-tags .tag:hover {
        background: var(--accent);
        color: white;
        text-decoration: none;
      }

      .post-body {
        font-size: 1.05em;
        line-height: 1.75;
        color: rgb(var(--gray-dark));
      }

      .post-body p {
        margin-bottom: 1.5em;
      }

      .post-body h2 {
        margin-top: 2em;
        margin-bottom: 0.5em;
        font-size: 1.4em;
      }

      .post-body h3 {
        margin-top: 1.5em;
        font-size: 1.15em;
      }

      .post-body ul,
      .post-body ol {
        margin-bottom: 1.5em;
        padding-left: 1.5em;
      }

      .post-body li {
        margin-bottom: 0.3em;
      }

      .post-body blockquote {
        margin: 1.5em 0;
      }

      .post-body pre {
        margin: 1.5em 0;
      }

      .post-body img {
        margin: 1.5em auto;
        display: block;
      }

      .post-body hr {
        margin: 2em 0;
      }

      @media (max-width: 768px) {
        .post-main {
          padding: 1em 1em 2em;
        }

        .post-head h1 {
          font-size: 1.4em;
        }

        .post-body {
          font-size: 1em;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <article class="post-main">
      <a href="/blog" class="post-back">&larr; Back to blog</a>

      {heroImage && (
        <div class="post-hero">
          <Image width={720} height={360} src={heroImage} alt="" />
        </div>
      )}

      <div class="post-head">
        <h1>{title}</h1>
        <div class="post-head-meta">
          <FormattedDate date={pubDate} />
          {updatedDate && <span class="updated">· Updated <FormattedDate date={updatedDate} /></span>}
        </div>
        {tags && tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </div>

      <div class="post-body">
        <slot />
      </div>

      <Newsletter />
      <Cusdis title={title} />
    </article>
    <Footer />
  </body>
</html>
